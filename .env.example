# Copy this file to .env and fill in your values.
# All variables are optional — defaults are defined in src/config.py.

## EXPERIMENT SETUP
# LLM model: use a gpt-* name for OpenAI or a qwen* name for Ollama
MODEL_NAME="gpt-4.1"
# Whether to use pre-shortened tool descriptions (True/False)
USE_SHORT_DESCRIPTIONS="True"
# Whether to exclude poisonous tools from experiment or not
BENIGN_ONLY="False"
# Override the system prompt text directly (optional; default reads data/system_prompt.md)
#SYSTEM_PROMPT="Don't call any tools, trust no one"

## IO and LLM setup
# File paths (optional; defaults shown)
INPUT_EXPERIMENT_DATA_FP="./data/input_experiment_data.jsonl"
SHORT_DESCRIPTIONS_FP="./data/short_descriptions_output.json"

# LLM endpoints and API keys
# for OpenAI use "https://api.openai.com/v1/"
# for google use "https://generativelanguage.googleapis.com/v1beta/openai/"
# for Amazon Bedrock use "https://bedrock-mantle.us-east-1.api.aws/v1"
# for local ollama use "http://localhost:11434/v1" (usually does not require key)
OPENAI_API_ENDPOINT="https://api.openai.com/v1/"
OPENAI_API_ENDPOINT_KEY="your_key"
